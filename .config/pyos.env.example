# Copy to .config/pyos.env and adjust. Load it before starting PyOS, e.g.
#   set -a; . .config/pyos.env; set +a; python Projectos.py
# Command-line flags override these.

# Address to listen on. 127.0.0.1 keeps PyOS private to this computer;
# 0.0.0.0 lets others on your network open it and use Messages with you.
PYOS_HOST=127.0.0.1

# Port for the desktop and API.
PYOS_PORT=8080

# Where the home folder (home/) and database (pyos.db) are stored.
PYOS_DATA_DIR=~/.pyos

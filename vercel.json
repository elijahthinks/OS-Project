{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src/frontend",
  "functions": {
    "api/index.py": {
      "includeFiles": "src/backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ]
}
